<h1 class="mb-4">Edit task</h1>
<%= render "form", task: @task %>
<%= link_to "Back to list", tasks_path, class: "btn btn-link mt-3 px-0" %>

<h1>Edit task</h1>

<%= form_with model: @task do |f| %>
  <%= f.label :title %>
  <%= f.text_field :title %>

  <%= f.label :details %>
  <%= f.text_area :details %>

  <%= f.check_box :completed %>
  <%= f.label :completed %>

  <%= f.submit %>
<% end %>

<%= link_to "Back to list", tasks_path %>
